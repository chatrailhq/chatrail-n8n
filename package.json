{
	"name": "n8n-nodes-chatrail",
	"version": "0.1.3",
	"description": "n8n nodes for ChatRail: send WhatsApp messages, check numbers and trigger workflows from WhatsApp events.",
	"license": "MIT",
	"homepage": "https://www.chatrail.dev/integrations/n8n",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"whatsapp",
		"whatsapp-api",
		"chatrail"
	],
	"author": {
		"name": "ChatRail",
		"email": "support@chatrail.dev"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chatrailhq/chatrail-n8n.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ChatRailApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ChatRail/ChatRail.node.js",
			"dist/nodes/ChatRailTrigger/ChatRailTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.3",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"publishConfig": {
		"access": "public"
	}
}
